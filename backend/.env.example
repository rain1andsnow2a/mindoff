# ===== 阶跃星辰 API（真实值写到 backend/.env，勿入库）=====
STEPFUN_API_KEY=your-stepfun-key-here
STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_WS_BASE=wss://api.stepfun.com/v1

# ===== 模型默认值（改一处全局生效）=====
STEP_TEXT_MODEL=step-3.5-flash
STEP_ASR_FILE_MODEL=stepaudio-2.5-asr
STEP_ASR_STREAM_MODEL=stepaudio-2.5-asr-stream
STEP_REALTIME_MODEL=stepaudio-2.5-realtime
STEP_REALTIME_VOICE=linjiajiejie

# 桌宠默认人设（实时语音 session instructions），RN 可运行时覆盖
STEP_REALTIME_INSTRUCTIONS=你是 MindOff 的桌宠，温柔、不催促、不评判，用简短口语陪伴用户。

# ===== 服务 =====
# 逗号分隔的允许来源；* 表示全部（开发期）
CORS_ORIGINS=*
